APP_NAME="BPKAD Donggala"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://apibpkad.itdonggala.my.id

LOG_CHANNEL=stack
LOG_LEVEL=error

# Hostname "db" = nama service di docker-compose, JANGAN diganti 127.0.0.1
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=bpkad_donggala
DB_USERNAME=bpkad_user
DB_PASSWORD=GANTI_PASSWORD_DB_KUAT
DB_ROOT_PASSWORD=GANTI_PASSWORD_ROOT_KUAT

CACHE_DRIVER=file
CACHE_STORE=file
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

SANCTUM_STATEFUL_DOMAINS=IP_ATAU_DOMAIN_FRONTEND

# WAJIB diganti sebelum deploy!
ADMIN_NAME="Administrator"
ADMIN_EMAIL=admin@bpkad-donggala.go.id
ADMIN_PASSWORD=GANTI_PASSWORD_ADMIN_KUAT
